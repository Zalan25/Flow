/* Kérdések és válaszok beszúrása/frissítése */
DECLARE
    @SeedId INT,
    @LangCode NVARCHAR(10),
    @LevelName NVARCHAR(20),
    @TypeName NVARCHAR(50),
    @SkillName NVARCHAR(50),
    @Points INT,
    @QuestionText NVARCHAR(1000),
    @QuestionId INT;

DECLARE qcur CURSOR LOCAL FAST_FORWARD FOR
SELECT SeedId, LangCode, LevelName, TypeName, SkillName, Points, QuestionText
FROM #QuestionSeed
ORDER BY SeedId;

OPEN qcur;
FETCH NEXT FROM qcur INTO @SeedId, @LangCode, @LevelName, @TypeName, @SkillName, @Points, @QuestionText;

WHILE @@FETCH_STATUS = 0
BEGIN
    SELECT @QuestionId = q.QuestionId
    FROM {databaseOwner}[{objectQualifier}lm_questions] q
    INNER JOIN {databaseOwner}[{objectQualifier}lm_languages] l
        ON l.LanguageId = q.LanguageId
    INNER JOIN {databaseOwner}[{objectQualifier}lm_question_levels] ql
        ON ql.QuestionLevelId = q.QuestionLevelId
    INNER JOIN {databaseOwner}[{objectQualifier}lm_question_types] qt
        ON qt.QuestionTypeId = q.QuestionTypeId
    INNER JOIN {databaseOwner}[{objectQualifier}lm_skill_types] st
        ON st.SkillTypeId = q.SkillTypeId
    WHERE q.ModuleId = @ModuleId
      AND l.Code = @LangCode
      AND ql.LevelName = @LevelName
      AND qt.TypeName = @TypeName
      AND st.SkillName = @SkillName
      AND q.QuestionText = @QuestionText;

    IF @QuestionId IS NULL
    BEGIN
        INSERT INTO {databaseOwner}[{objectQualifier}lm_questions]
        (
            ModuleId,
            QuestionText,
            LanguageId,
            QuestionLevelId,
            QuestionTypeId,
            SkillTypeId,
            Points,
            IsActive
        )
        SELECT
            @ModuleId,
            @QuestionText,
            l.LanguageId,
            ql.QuestionLevelId,
            qt.QuestionTypeId,
            st.SkillTypeId,
            @Points,
            1
        FROM {databaseOwner}[{objectQualifier}lm_languages] l
        CROSS JOIN {databaseOwner}[{objectQualifier}lm_question_levels] ql
        CROSS JOIN {databaseOwner}[{objectQualifier}lm_question_types] qt
        CROSS JOIN {databaseOwner}[{objectQualifier}lm_skill_types] st
        WHERE l.Code = @LangCode
          AND ql.LevelName = @LevelName
          AND qt.TypeName = @TypeName
          AND st.SkillName = @SkillName;

        SET @QuestionId = SCOPE_IDENTITY();
    END
    ELSE
    BEGIN
        UPDATE {databaseOwner}[{objectQualifier}lm_questions]
        SET Points = @Points,
            IsActive = 1
        WHERE QuestionId = @QuestionId;

        DELETE FROM {databaseOwner}[{objectQualifier}lm_answers]
        WHERE QuestionId = @QuestionId;
    END

    INSERT INTO #QuestionMap (SeedId, QuestionId)
    VALUES (@SeedId, @QuestionId);

    INSERT INTO {databaseOwner}[{objectQualifier}lm_answers]
    (
        ModuleId,
        QuestionId,
        AnswerText,
        IsCorrect,
        AnswerOrder
    )
    SELECT
        @ModuleId,
        @QuestionId,
        AnswerText,
        IsCorrect,
        AnswerOrder
    FROM #AnswerSeed
    WHERE SeedId = @SeedId
    ORDER BY AnswerOrder;

    SET @QuestionId = NULL;

    FETCH NEXT FROM qcur INTO @SeedId, @LangCode, @LevelName, @TypeName, @SkillName, @Points, @QuestionText;
END

CLOSE qcur;
DEALLOCATE qcur;

/* Csak az 5 kérdéses tesztek létrehozása/frissítése */
DECLARE
    @Code NVARCHAR(10),
    @LanguageId INT,
    @LangName NVARCHAR(100),
    @TestId INT,
    @TestName NVARCHAR(150),
    @TotalPoints INT;

DECLARE lcur CURSOR LOCAL FAST_FORWARD FOR
SELECT DISTINCT LangCode
FROM #QuestionSeed
WHERE TestCode = N'05'
ORDER BY LangCode;

OPEN lcur;
FETCH NEXT FROM lcur INTO @Code;

WHILE @@FETCH_STATUS = 0
BEGIN
    SELECT
        @LanguageId = LanguageId,
        @LangName = [Name]
    FROM {databaseOwner}[{objectQualifier}lm_languages]
    WHERE Code = @Code;

    SET @TestName = @LangName + N' fix szintfelmérő - 5 kérdés';

    SELECT @TotalPoints = SUM(Points)
    FROM #QuestionSeed
    WHERE LangCode = @Code
      AND TestCode = N'05';

    SELECT @TestId = TestId
    FROM {databaseOwner}[{objectQualifier}lm_tests]
    WHERE ModuleId = @ModuleId
      AND LanguageId = @LanguageId
      AND TestName = @TestName;

    IF @TestId IS NULL
    BEGIN
        INSERT INTO {databaseOwner}[{objectQualifier}lm_tests]
        (
            ModuleId,
            TestName,
            Characterization,
            LanguageId,
            TotalPoints,
            IsRandom,
            IsActive
        )
        VALUES
        (
            @ModuleId,
            @TestName,
            N'5 kérdéses fix szintfelmérő: A1, A2, B1, B2 és C1 szintből 1-1 kérdés.',
            @LanguageId,
            @TotalPoints,
            0,
            1
        );

        SET @TestId = SCOPE_IDENTITY();
    END
    ELSE
    BEGIN
        UPDATE {databaseOwner}[{objectQualifier}lm_tests]
        SET Characterization = N'5 kérdéses fix szintfelmérő: A1, A2, B1, B2 és C1 szintből 1-1 kérdés.',
            TotalPoints = @TotalPoints,
            IsRandom = 0,
            IsActive = 1
        WHERE TestId = @TestId;

        DELETE FROM {databaseOwner}[{objectQualifier}lm_test_questions]
        WHERE TestId = @TestId;
    END

    INSERT INTO #TestMap (TestCode, LangCode, TestId)
    VALUES (N'05', @Code, @TestId);

    SET @LanguageId = NULL;
    SET @LangName = NULL;
    SET @TestId = NULL;
    SET @TestName = NULL;
    SET @TotalPoints = NULL;

    FETCH NEXT FROM lcur INTO @Code;
END

CLOSE lcur;
DEALLOCATE lcur;

INSERT INTO {databaseOwner}[{objectQualifier}lm_test_questions]
(
    ModuleId,
    TestId,
    QuestionId,
    QuestionOrder
)
SELECT
    @ModuleId,
    tm.TestId,
    qm.QuestionId,
    qs.QuestionOrder
FROM #QuestionSeed qs
INNER JOIN #QuestionMap qm
    ON qm.SeedId = qs.SeedId
INNER JOIN #TestMap tm
    ON tm.LangCode = qs.LangCode
   AND tm.TestCode = qs.TestCode
WHERE qs.TestCode = N'05'
ORDER BY
    qs.LangCode,
    qs.QuestionOrder;

/* Ellenőrzés: minden létrehozott teszt pontosan 5 kérdéses legyen */
IF EXISTS
(
    SELECT 1
    FROM #TestMap tm
    INNER JOIN {databaseOwner}[{objectQualifier}lm_test_questions] tq
        ON tq.TestId = tm.TestId
    GROUP BY tm.TestId
    HAVING COUNT(*) <> 5
)
BEGIN
    RAISERROR(N'A 5 kérdéses szintfelmérő seed hibás: van olyan teszt, amely nem pontosan 5 kérdésből áll.', 16, 1);
END

IF OBJECT_ID('tempdb..#QuestionSeed') IS NOT NULL DROP TABLE #QuestionSeed;
IF OBJECT_ID('tempdb..#AnswerSeed') IS NOT NULL DROP TABLE #AnswerSeed;
IF OBJECT_ID('tempdb..#QuestionMap') IS NOT NULL DROP TABLE #QuestionMap;
IF OBJECT_ID('tempdb..#TestMap') IS NOT NULL DROP TABLE #TestMap;
