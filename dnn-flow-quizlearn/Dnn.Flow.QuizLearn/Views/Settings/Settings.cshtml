@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Dnn.Flow.QuizLearn.Models.SettingsViewModel>
<link rel="stylesheet" href="/DesktopModules/MVC/Dnn.Flow.QuizLearn/css/settings.css?v=1" />

<div class="quizlearn-settings-wrapper">
    <div class="quizlearn-settings-card">

        <h2 class="quizlearn-settings-title">QuizLearn beállítások</h2>

        <p class="quizlearn-settings-description">
            Itt állíthatod be a modul működési módját és a szintfelmérőben használható nyelveket.
        </p>

        <div class="quizlearn-settings-section">
            <h3 class="quizlearn-settings-section-title">Működési mód</h3>

            <p class="quizlearn-settings-help">
                Válaszd ki, hogy a modul milyen funkcióval jelenjen meg az oldalon.
            </p>

            <div class="quizlearn-settings-field">
                <label for="Mode" class="quizlearn-settings-label">
                    Modul működési módja
                </label>

                <select id="Mode" name="Mode" class="quizlearn-settings-select">
                    @foreach (var item in Model.AvailableModes)
                    {
                        <option value="@item.Value" @(item.Value == ((int)Model.Mode).ToString() ? "selected" : "")>
                            @item.Text
                        </option>
                    }
                </select>
            </div>
        </div>

        <div class="quizlearn-settings-section">
            <h3 class="quizlearn-settings-section-title">Aktív szintfelmérő nyelvek</h3>

            <p class="quizlearn-settings-help">
                Csak a kijelölt nyelvek jelennek meg a szintfelmérő indításakor.
            </p>

            <input type="hidden"
                   id="ActiveAssessmentLanguageIds"
                   name="ActiveAssessmentLanguageIds"
                   value="@string.Join(",", Model.ActiveAssessmentLanguageIds)" />

            <div class="quizlearn-settings-language-grid">
                @foreach (var language in Model.AvailableLanguages)
                {
                    var languageId = int.Parse(language.Value);

                    <label class="quizlearn-settings-language-option">
                        <input type="checkbox"
                               class="active-language-checkbox"
                               value="@language.Value"
                               @(Model.ActiveAssessmentLanguageIds.Contains(languageId) ? "checked" : "") />

                        <span>@language.Text</span>
                    </label>
                }
            </div>
        </div>

        <div class="quizlearn-settings-section">
            <div class="quizlearn-settings-success">
                A módosítások mentéséhez kattints lent a DNN Frissítés gombjára.
            </div>
        </div>

        <script>
            (function () {
                function updateActiveLanguages() {
                    var values = [];

                    var checkboxes = document.querySelectorAll('.active-language-checkbox');

                    for (var i = 0; i < checkboxes.length; i++) {
                        if (checkboxes[i].checked) {
                            values.push(checkboxes[i].value);
                        }
                    }

                    document.getElementById('ActiveAssessmentLanguageIds').value = values.join(',');
                }

                var checkboxes = document.querySelectorAll('.active-language-checkbox');

                for (var i = 0; i < checkboxes.length; i++) {
                    checkboxes[i].addEventListener('change', updateActiveLanguages);
                }

                updateActiveLanguages();
            })();
        </script>

    </div>
</div>