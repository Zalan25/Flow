@inherits DotNetNuke.Web.Mvc.Framework.DnnWebViewPage<Dnn.Flow.QuizLearn.Models.SettingsViewModel>

<div class="form-group">
    <label for="Mode">Modul működési módja</label>

    <select id="Mode" name="Mode" class="form-control">
        @foreach (var item in Model.AvailableModes)
        {
        <option value="@item.Value" @(item.Value == ((int)Model.Mode).ToString() ? "selected" : "")>
            @item.Text
        </option>
        }
    </select>
</div>

<div class="alert alert-info">
    Válaszd ki a működési módot, majd alul kattints a DNN Update gombra.
</div>


<div class="form-group">
    <label>Aktív szintfelmérő nyelvek</label>

    @foreach (var language in Model.AvailableLanguages)
    {
        var languageId = int.Parse(language.Value);

    <div class="checkbox">
        <label>
            <input type="checkbox"
                   name="ActiveAssessmentLanguageIds"
                   value="@language.Value"
                   @(Model.ActiveAssessmentLanguageIds.Contains(languageId) ? "checked" : "") />

            @language.Text
        </label>
    </div>
    }
</div>

<div class="alert alert-info">
    Csak a kijelölt nyelvek jelennek meg a szintfelmérő indításakor.
</div>